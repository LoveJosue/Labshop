<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff;">
  <tr>
    <td align="center">
      <table width="600" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff;font-family:'Poppins',Arial,sans-serif;color:#333;">

        <!-- LOGO -->
        <tr>
          <td align="center" style="padding:10px 30px 0 30px;">
            <img src="cid:labstore-logo" alt="Labstore" width="200" height="56"
                 style="display:block;border:0;outline:none;text-decoration:none;width:200px;height:auto;" />
          </td>
        </tr>

        <!-- TITRE -->
        <tr>
          <td align="center" style="padding:24px 30px 10px 30px;">
            <h1 style="font-size:20px;line-height:1.6;font-weight:700;margin:0;">
              Votre mot de passe a été modifié
            </h1>
          </td>
        </tr>

        <!-- MESSAGE -->
        <tr>
          <td align="center" style="padding:15px 30px 20px 30px;">
            <p style="font-size:14px;line-height:1.6;margin:0 0 12px 0;">
              {{#if prename}}Bonjour {{prename}},{{else}}Bonjour,{{/if}}
            </p>
            <p style="font-size:14px;line-height:1.6;margin:0 0 12px 0;">
              Le mot de passe de votre compte Labstore vient d'être modifié.
              Par sécurité, toutes vos sessions ouvertes ont été déconnectées :
              reconnectez-vous avec votre nouveau mot de passe.
            </p>
          </td>
        </tr>

        <!-- AVERTISSEMENT -->
        <tr>
          <td style="padding:0 30px 30px 30px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f5f5f5;">
              <tr>
                <td style="padding:16px 20px;">
                  <p style="font-size:13px;line-height:1.6;color:#555;margin:0;">
                    Vous n'êtes pas à l'origine de ce changement ? Contactez-nous immédiatement à
                    <a href="mailto:contact@labstore.ca" style="color:#111;font-weight:600;">contact@labstore.ca</a>
                    afin que nous sécurisions votre compte.
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>