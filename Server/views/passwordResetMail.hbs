<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff;">
  <tr>
    <td align="center">
      <table width="600" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff;font-family:'Poppins',Arial,sans-serif;color:#333;">

        <!-- LOGO -->
        <tr>
          <td align="center" style="padding:10px 30px 0 30px;">
            <img src="cid:labstore-logo" alt="Labstore" width="200" height="56"
                 style="display:block;border:0;outline:none;text-decoration:none;width:200px;height:auto;" />
          </td>
        </tr>

        <!-- TITRE -->
        <tr>
          <td align="center" style="padding:24px 30px 10px 30px;">
            <h1 style="font-size:20px;line-height:1.6;font-weight:700;margin:0;">
              Réinitialisation de votre mot de passe
            </h1>
          </td>
        </tr>

        <!-- MESSAGE -->
        <tr>
          <td align="center" style="padding:15px 30px 10px 30px;">
            <p style="font-size:14px;line-height:1.6;margin:0 0 12px 0;">
              {{#if prename}}Bonjour {{prename}},{{else}}Bonjour,{{/if}}
            </p>
            <p style="font-size:14px;line-height:1.6;margin:0 0 12px 0;">
              Nous avons reçu une demande de réinitialisation du mot de passe de votre compte Labstore.
              Cliquez sur le bouton ci-dessous pour en choisir un nouveau.
            </p>
          </td>
        </tr>

        <!-- BOUTON -->
        <tr>
          <td align="center" style="padding:20px 30px;">
            <table cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td align="center" style="background:#111111;border-radius:4px;">
                  {{! Triple accolade : sans elle Handlebars échappe le '=' de la query
                      string en &#x3D;, illisible dans le lien de secours à recopier.
                      L'URL est construite entièrement côté serveur (FRONT_END_URL +
                      jeton aléatoire), elle ne contient aucune donnée utilisateur. }}
                  <a href="{{{resetUrl}}}"
                     style="display:inline-block;padding:14px 32px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;">
                    Choisir un nouveau mot de passe
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- VALIDITE -->
        <tr>
          <td align="center" style="padding:0 30px 20px 30px;">
            <p style="font-size:13px;line-height:1.6;color:#666;margin:0;">
              Ce lien est valable <strong>{{expiresInMinutes}} minutes</strong> et ne peut servir qu'une seule fois.
            </p>
          </td>
        </tr>

        <!-- LIEN DE SECOURS -->
        <tr>
          <td style="padding:0 30px 20px 30px;">
            <p style="font-size:13px;line-height:1.6;color:#666;margin:0 0 6px 0;">
              Si le bouton ne fonctionne pas, copiez cette adresse dans votre navigateur :
            </p>
            <p style="font-size:12px;line-height:1.5;color:#444;word-break:break-all;margin:0;">
              {{{resetUrl}}}
            </p>
          </td>
        </tr>

        <!-- AVERTISSEMENT -->
        <tr>
          <td style="padding:0 30px 30px 30px;">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f5f5f5;">
              <tr>
                <td style="padding:16px 20px;">
                  <p style="font-size:13px;line-height:1.6;color:#555;margin:0;">
                    Vous n'êtes pas à l'origine de cette demande ? Ignorez simplement ce message :
                    votre mot de passe actuel reste valable et aucune modification ne sera apportée à votre compte.
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>